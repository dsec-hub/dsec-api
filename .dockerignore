# Keep the build context small and secrets out of the image.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets — never bake these in. Config arrives via docker compose env_file.
.env
.env.*
!.env.example
!.env.production.example

# Local-only artefacts
local.db
*.db
*.sqlite3

# Not needed at runtime
tests
docs
integrations
README.md
vercel.json
Dockerfile
compose.yaml
Caddyfile
deploy
