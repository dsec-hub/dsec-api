# DSEC API — VPS production environment.
#
#   cp .env.production.example .env     # then fill in the real values
#
# This is the DEPLOYMENT overlay: the handful of variables that are new or that
# differ on the VPS, plus the ones the app refuses to boot without. Every other
# tunable keeps its code default — see .env.example for the full 43-key list and
# docs/configuration.md for what each one does.
#
# NEVER commit the resulting .env. It is in .gitignore and .dockerignore; config
# reaches the containers through `env_file:`, so nothing is baked into the image.

# --- Deployment identity (new on the VPS) -----------------------------------
# APP_ENV=production turns on validate_production_settings(), which refuses to
# boot with placeholder secrets or a SQLite database. It replaces Vercel's
# VERCEL=1, which is what that check used to key off — without this the guard
# silently does nothing. docker compose already sets it; keep it here too so a
# bare `docker run` is equally safe.
APP_ENV=production

# Used by the Caddyfile for the vhost and the ACME account.
API_DOMAIN=api.dsec.club
ACME_EMAIL=deakinsec@gmail.com

# --- Required — the app will not start without these ------------------------
# Neon POOLED connection string (note the "-pooler" host segment), rewritten to
# SQLAlchemy + psycopg form. Keep the region ap-southeast-2: the VPS is in OVH
# Sydney, and co-locating app and database is the entire performance argument
# for this migration (the Vercel deploy ran in iad1 and paid ~2.7s per request
# crossing the Pacific to reach this same database).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

AGENT_SECRET=
DASHBOARD_USER=admin
DASHBOARD_PASS=

# --- Connection pool (new; see app/db.py) -----------------------------------
# 15 + 5 replaces the serverless-era 5 + 2. Raise only alongside Neon's pooled
# connection ceiling, and remember dsec-hub holds its own pool against the same
# database.
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5

# --- Cron (replaces the vercel.json `crons` block) --------------------------
# The cron container sends this as a bearer token to /games/cron/close-draw.
# Blank disables the endpoint entirely, so the monthly draw would never close.
CRON_SECRET=

# --- Everything below is optional; blank disables the feature ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Pin the OAuth issuer in production so it cannot be influenced by a spoofed
# Host header (blank = derived per-request, which is only right locally).
OAUTH_ISSUER=https://api.dsec.club

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

HUB_NOTIFY_URL=https://hub.dsec.club/api/internal/notify-assignment
HUB_NOTIFY_SECRET=

TALLY_API_KEY=
GAMES_BASE_URL=https://games.dsec.club
